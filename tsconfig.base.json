{
  "compilerOptions": {
    "target": "ES2018"
  , "module": "NodeNext"
  , "moduleResolution": "NodeNext"
  , "strict": true
  , "esModuleInterop": true
  , "skipLibCheck": true
  , "noUnusedLocals": false
  , "noUnusedParameters": false
  , "rootDir": "src"
  , "paths": {
      "@utils/*": ["./src/utils/*"]
    , "@src/*": ["./src/*"]
    , "@test/*": ["./__tests__/*"]
    }
  }
}
